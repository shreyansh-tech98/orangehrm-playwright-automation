{
  "name": "orangehrm-playwright-js",
  "version": "1.0.0",
  "description": "Playwright JS test automation suite for OrangeHRM (e2e, ui, api, visual)",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e --project=chromium ",
    "test:ui-suite": "playwright test tests/ui",
    "test:api": "playwright test tests/api --project=api",
    "test:visual": "playwright test tests/visual",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:staging": "cross-env ENV=staging playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "report": "playwright show-report reports/html-report",
    "clean:allur:report": "npx allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:report": "npx allure open reports/allure-report",
    "codegen": "playwright codegen https://opensource-demo.orangehrmlive.com/web/index.php/auth/login",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "allure-playwright": "^3.12.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.2",
    "prettier": "^3.3.3"
  }
}
